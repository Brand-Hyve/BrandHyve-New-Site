---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Google Review Automation Software | Brand Hyve" description="Automate review requests, reply with AI, escalate negative feedback for owner resolution, and generate keyword-rich social proof with Brand Hyve." schemaType="faq" ogImage="/og-reviews.jpg">
  <!-- Global Decorative Background Glows -->
  <div class="glow-glow" style="top: 20%; right: 10%;"></div>
  <div class="glow-glow" style="top: 70%; left: 5%; width: 250px; height: 250px; background: #888888; animation-delay: -2s;"></div>

  <!-- Hero Section -->
  <section class="section-padding reviews-hero">
    <div class="section-header">
      <span class="caption">Review Automation</span>
      <h1 class="display-xl">Stop Chasing Customers. Automate Your Google Reviews.</h1>
      <p class="body-lg">Your customers are happy and the job is done right. But asking for reviews manually gets you crickets. Brand Hyve automates the entire process so you rank higher on Google maps and win more clients.</p>
    </div>
  </section>

  <!-- Problem Section (Pain-Point-First) -->
  <section class="section-padding problem-section-new" style="padding-top: 0;">
    <div class="section-header">
      <span class="caption">The Problem</span>
      <h2 class="display-lg">Your Business Deserves More Reviews</h2>
      <p class="body-lg">Your customers are happy. You make sure the job is done right. But when it comes time to get a review... crickets.</p>
    </div>
    <div class="card-grid">
      <div class="card spotlight-card col-4">
        <div class="spotlight-card-content">
          <div class="feature-icon">🤫</div>
          <h3>No Reviews</h3>
          <p>You have lots of happy customers but only a few reviews to show for it. So you have to prove yourself to new leads manually.</p>
        </div>
      </div>
      <div class="card spotlight-card col-4">
        <div class="spotlight-card-content">
          <div class="feature-icon">⏳</div>
          <h3>No Time</h3>
          <p>As a busy business owner, you don't have time to chase customers down to ask for reviews. You're wearing enough hats already.</p>
        </div>
      </div>
      <div class="card spotlight-card col-4">
        <div class="spotlight-card-content">
          <div class="feature-icon">🫣</div>
          <h3>No Google Visibility</h3>
          <p>Your ideal customers are choosing competitors just because they have more stars. You know you do better work, but new leads don't.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bento Feature Section -->
  <section class="section-padding bento-features-section" style="padding-top: 0;">
    <div class="section-header">
      <span class="caption">Review Automation Made Simple</span>
      <h2 class="display-lg">Getting Reviews Has Never Been Easier</h2>
      <p class="body-lg">Brand Hyve does the hard work for you. With easy-to-use automated features, watch your local reputation grow on autopilot.</p>
    </div>

    <div class="bento-grid">
      <!-- Card 1: Personalized Requests (Large) -->
      <div class="card spotlight-card bento-col-8">
        <div class="spotlight-card-content bento-horizontal">
          <div class="bento-text">
            <div class="feature-icon">✉️</div>
            <h3>Personalized Review Requests</h3>
            <p class="body-md">Personalized text and email requests featuring your customer's name and team photo to break patterns, capture attention, and dramatically increase conversion rates.</p>
          </div>
          <div class="bento-visual sms-mockup-wrapper">
            <div class="sms-phone">
              <div class="sms-header">Brand Hyve Automation</div>
              <div class="sms-body">
                <div class="sms-message received">
                  <p>Hey <strong>John</strong>! Thanks for choosing us today. Could you leave us a quick review? We donate a meal for every review we get. Here is a link: <span>brandhyve.link/review</span></p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: AI Review Responses -->
      <div class="card spotlight-card bento-col-4">
        <div class="spotlight-card-content">
          <div class="feature-icon">🤖</div>
          <h3>AI Review Responses</h3>
          <p>We take the burden off you. Our AI assistant instantly drafts keyword-rich replies to all positive reviews to boost local maps indexing.</p>
        </div>
      </div>

      <!-- Card 3: CRM & Tool Integrations -->
      <div class="card spotlight-card bento-col-4">
        <div class="spotlight-card-content">
          <div class="feature-icon">🔌</div>
          <h3>Seamless Integrations</h3>
          <p>Compatible with Jobber, Housecall Pro, Zapier, and custom CRM webhooks. Connect once and automate requests on job completion.</p>
        </div>
      </div>

      <!-- Card 4: Smart Follow-ups -->
      <div class="card spotlight-card bento-col-4">
        <div class="spotlight-card-content">
          <div class="feature-icon">🔄</div>
          <h3>Smart Follow-ups</h3>
          <p>Send gentle, automated reminders to customers who haven't left a review yet, securing high-quality responses without pestering.</p>
        </div>
      </div>

      <!-- Card 5: Review Reactivation -->
      <div class="card spotlight-card bento-col-4">
        <div class="spotlight-card-content">
          <div class="feature-icon">💥</div>
          <h3>Database Reactivation</h3>
          <p>Instantly target past databases of happy customers who "said" they would leave a review, generating a huge initial surge of reviews.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Feedback Simulator Section -->
  <section id="routing" class="section-padding routing-section">
    <div class="routing-split">
      <div class="routing-left">
        <span class="caption">AI Feedback Assistant</span>
        <h2 class="display-lg">Responsive Support Engine</h2>
        <p class="body-lg">
          Select a star rating below to see how our system customizes the customer path to maximize positive review impact and resolve issues fast.
        </p>

        <!-- Star selector -->
        <div class="star-rating-simulator">
          <div class="star-prompt">Select rating to simulate:</div>
          <div class="star-row">
            <span class="simulator-star" data-rating="1">★</span>
            <span class="simulator-star" data-rating="2">★</span>
            <span class="simulator-star" data-rating="3">★</span>
            <span class="simulator-star" data-rating="4">★</span>
            <span class="simulator-star" data-rating="5">★</span>
          </div>
        </div>
      </div>

      <div class="routing-right">
        <div class="glass-card router-visualizer">
          <!-- Screen 1: Initial -->
          <div id="route-screen-initial" class="route-screen">
            <div class="engine-icon pulse">⚙️</div>
            <h3>AI Assistant Ready</h3>
            <p>Select a rating on the left to see the AI assistant's response strategy.</p>
          </div>

          <!-- Screen 2: Positive Routing (4 & 5 stars) - Ask for keyword and write review -->
          <div id="route-screen-positive" class="route-screen hidden">
            <div class="engine-icon success">🚀</div>
            <h3>AI Review Assistant</h3>
            <p class="route-path-desc">Rating: <span class="rating-badge tag-pos">4-5 Stars</span></p>
            
            <!-- Step A: Ask for keywords -->
            <div id="pos-step-keywords" class="feedback-step">
              <p class="step-label">What did you like about our service? Select keywords to help write your review:</p>
              <div class="keyword-pills">
                <button type="button" class="keyword-pill" data-keyword="efficient">Efficient</button>
                <button type="button" class="keyword-pill" data-keyword="friendly">Friendly</button>
                <button type="button" class="keyword-pill" data-keyword="professional">Professional</button>
                <button type="button" class="keyword-pill" data-keyword="responsive">Responsive</button>
                <button type="button" class="keyword-pill" data-keyword="knowledgeable">Knowledgeable</button>
              </div>
              <div class="simulator-input-group">
                <input type="text" id="custom-keyword-input" placeholder="Or enter custom keywords (e.g. fast, helpful)..." />
              </div>
              <button type="button" id="generate-review-btn" class="btn-primary" style="margin-top: 5px; width: 100%;">Generate AI Review</button>
            </div>

            <!-- Step B: Display generated review and copy button -->
            <div id="pos-step-result" class="feedback-step hidden">
              <div class="route-result-box">
                <strong>Your Drafted Review:</strong>
                <p id="generated-review-text" style="color: var(--ink); font-style: italic;"></p>
              </div>
              <p style="font-size: 12px; color: var(--ink-muted); margin-bottom: 15px;">Copy this review and post it on Google Business Profile to boost local rankings.</p>
              <div class="action-buttons-row">
                <button type="button" id="copy-review-btn" class="btn-primary">Copy Review</button>
                <button type="button" class="btn-secondary route-reset-btn">Start Over</button>
              </div>
            </div>
          </div>

          <!-- Screen 3: Negative Routing (1-3 stars) - Escalate to owner -->
          <div id="route-screen-negative" class="route-screen hidden">
            <div class="engine-icon warning">📧</div>
            <h3>Owner Support Escalation</h3>
            <p class="route-path-desc">Rating: <span class="rating-badge tag-neg">1-3 Stars</span></p>

            <!-- Step A: Explain escalation and show feedback box -->
            <div id="neg-step-form" class="feedback-step">
              <p class="step-label">Your experience is important. Tell us what went wrong so the owner can reach out and resolve it:</p>
              <div class="simulator-input-group">
                <textarea id="negative-feedback-text" placeholder="Please describe your experience..."></textarea>
              </div>
              <button type="button" id="submit-escalation-btn" class="btn-primary" style="margin-top: 5px; width: 100%;">Send to Owner</button>
            </div>

            <!-- Step B: Confirmation -->
            <div id="neg-step-result" class="feedback-step hidden">
              <div class="route-result-box" style="border-color: rgba(255, 219, 21, 0.2);">
                <strong>Owner Contact Initiated</strong>
                <p style="color: var(--ink);">Your feedback has been sent directly to the owner. They will respond shortly to address your bad experience or offer a make-good resolution.</p>
              </div>
              <button type="button" class="btn-secondary route-reset-btn" style="margin-top: 10px; width: 100%;">Start Over</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ambassador Section -->
  <section class="section-padding ambassador-section" style="padding-top: 0;">
    <div class="atmosphere-card-yellow">
      <div class="atmosphere-content" style="max-width: 100%;">
        <span class="caption" style="color: var(--ink-dark);">Ambassador Engine</span>
        <h2>Convert Reviewers to Referral Advocates</h2>
        <p style="color: var(--ink-dark); margin-bottom: 25px;">
          Do not stop at 5-star ratings. Our ambassador engine automatically invites happy reviewers to join your loyalty or affiliate program. Convert satisfied clients into active promoters who drive consistent word-of-mouth growth.
        </p>
        <a href="/contact" class="btn-primary" style="background-color: var(--ink-dark); color: var(--accent-yellow);">Activate Advocates</a>
      </div>
    </div>
  </section>

  <!-- Scroll-Triggered Stats Counters -->
  <section class="section-padding stats-section" style="padding-top: 0;">
    <div class="atmosphere-card-grey border-beam-card">
      <div class="border-beam-content" style="width: 100%;">
        <h2 class="display-md" style="text-align: center; margin-bottom: 50px; color: var(--ink);">Why Google Reviews Matter</h2>
        <div class="stats-counters-grid">
          <div class="counter-item">
            <span class="stat-counter display-xl" data-limit="92" data-suffix="%">0%</span>
            <span class="counter-label">of consumers read online reviews before choosing local businesses.</span>
          </div>
          <div class="counter-item">
            <span class="stat-counter display-xl" data-limit="72" data-suffix="%">0%</span>
            <span class="counter-label">of customers won't take action until reading a positive review.</span>
          </div>
          <div class="counter-item">
            <span class="stat-counter display-xl" data-limit="54" data-suffix="%">0%</span>
            <span class="counter-label">increase in business revenue for listings with 40+ positive reviews.</span>
          </div>
          <div class="counter-item">
            <span class="stat-counter display-xl" data-limit="84" data-suffix="%">0%</span>
            <span class="counter-label">trust online feedback as much as personal recommendations.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Supported Industries Section -->
  <section class="section-padding industries-section" style="padding-top: 0;">
    <div class="section-header">
      <span class="caption">Supported Verticals</span>
      <h2 class="display-lg">Every Local Service Supported</h2>
      <p class="body-lg">Optimized automated review request funnels customized for every local service industry.</p>
    </div>
    
    <div class="industries-grid">
      <div class="industry-badge"><span class="badge-icon">❄️</span> HVAC</div>
      <div class="industry-badge"><span class="badge-icon">🏠</span> Roofing</div>
      <div class="industry-badge"><span class="badge-icon">🪠</span> Plumbing</div>
      <div class="industry-badge"><span class="badge-icon">🦟</span> Pest Control</div>
      <div class="industry-badge"><span class="badge-icon">🧹</span> Cleaning</div>
      <div class="industry-badge"><span class="badge-icon">🎨</span> Painting</div>
      <div class="industry-badge"><span class="badge-icon">🚜</span> Landscaping</div>
      <div class="industry-badge"><span class="badge-icon">🧼</span> Carpet Cleaning</div>
      <div class="industry-badge"><span class="badge-icon">🎱</span> Pool Service</div>
      <div class="industry-badge"><span class="badge-icon">📦</span> Moving & Packing</div>
      <div class="industry-badge"><span class="badge-icon">🚧</span> Concrete & Coatings</div>
      <div class="industry-badge"><span class="badge-icon">🪚</span> Tree Care</div>
    </div>
    <div class="industries-more-container" style="display: flex; justify-content: center; margin-top: 25px;">
      <div class="industry-badge industries-more-badge" style="border-color: var(--accent-yellow); color: var(--accent-yellow); cursor: default;">
        500+ More
      </div>
    </div>
  </section>

  <!-- Pricing Cards Section -->
  <section id="pricing" class="section-padding pricing-section" style="padding-top: 0;">
    <div class="section-header">
      <span class="caption">Pricing Plans</span>
      <h2 class="display-lg">Simple, Transparent Pricing</h2>
      <p class="body-lg">Unlock review growth with packages structured for every growth stage. No hidden setup costs.</p>

      <!-- Toggle Switcher -->
      <div class="toggle-container">
        <span class="toggle-label active">Monthly</span>
        <label class="switch">
          <input type="checkbox" id="billing-toggle" />
          <span class="slider round"></span>
        </label>
        <span class="toggle-label">Yearly <span class="discount-badge">Save 20%</span></span>
      </div>
    </div>

    <div class="pricing-grid">
      <!-- Starter Card -->
      <div class="pricing-card">
        <span class="plan-badge">Starter</span>
        <div class="pricing-header">
          <span class="currency">$</span>
          <span class="pricing-val" data-monthly="99" data-yearly="79">99</span>
          <span class="pricing-period">/mo</span>
        </div>
        <p class="plan-desc">Up to 50 requests per month</p>
        <div style="font-size: 14px; font-weight: 600; margin-bottom: 15px; color: var(--ink);">What’s included</div>
        <ul class="plan-features">
          <li>Get 4x More Reviews</li>
          <li>Automated Text & Emails</li>
          <li>Review Reactivation</li>
          <li>Dynamic Review Follow-ups</li>
          <li>AI Smart Messaging</li>
          <li>Personalized Image Requests</li>
          <li>Auto AI Review Replies</li>
          <li>Social Media Review Posting</li>
          <li>Custom CRM Integration</li>
          <li>Access to Zapier</li>
          <li>Unlimited Users</li>
          <li>1-1 Setup Call</li>
        </ul>
        <a href="/contact" class="btn-secondary plan-btn" style="text-decoration: none;">Start 10-Day Free Trial</a>
      </div>

      <!-- Growth Card (Featured with yellow highlights) -->
      <div class="pricing-card featured-pricing border-beam-card">
        <div class="border-beam-content" style="height: 100%; display: flex; flex-direction: column; padding: 34px 29px;">
          <div class="popular-tag">POPULAR</div>
          <span class="plan-badge" style="color: var(--on-primary); margin-top: 20px;">Growth</span>
          <div class="pricing-header">
            <span class="currency" style="color: var(--on-primary);">$</span>
            <span class="pricing-val" data-monthly="179" data-yearly="139" style="color: var(--on-primary);">179</span>
            <span class="pricing-period" style="color: var(--on-primary);">/mo</span>
          </div>
          <p class="plan-desc" style="color: rgba(5, 5, 5, 0.75);">50-100 requests per month</p>
          <div style="font-size: 14px; font-weight: 600; margin-bottom: 15px; color: var(--on-primary);">What’s included</div>
          <ul class="plan-features dark-features">
            <li>Get 4x More Reviews</li>
            <li>Automated Text & Emails</li>
            <li>Review Reactivation</li>
            <li>Dynamic Review Follow-ups</li>
            <li>AI Smart Messaging</li>
            <li>Personalized Image Requests</li>
            <li>Auto AI Review Replies</li>
            <li>Social Media Review Posting</li>
            <li>Custom CRM Integration</li>
            <li>Access to Zapier</li>
            <li>Unlimited Users</li>
            <li>1-1 Setup Call</li>
          </ul>
          <a href="/contact" class="btn-primary plan-btn" style="background-color: var(--on-primary); color: var(--accent-yellow); text-decoration: none;">Start 10-Day Free Trial</a>
        </div>
      </div>

      <!-- Pro Card -->
      <div class="pricing-card">
        <span class="plan-badge">Pro</span>
        <div class="pricing-header">
          <span class="currency">$</span>
          <span class="pricing-val" data-monthly="279" data-yearly="219">279</span>
          <span class="pricing-period">/mo</span>
        </div>
        <p class="plan-desc">100-300 requests per month</p>
        <div style="font-size: 14px; font-weight: 600; margin-bottom: 15px; color: var(--ink);">What’s included</div>
        <ul class="plan-features">
          <li>Get 4x More Reviews</li>
          <li>Automated Text & Emails</li>
          <li>Review Reactivation</li>
          <li>Dynamic Review Follow-ups</li>
          <li>AI Smart Messaging</li>
          <li>Personalized Image Requests</li>
          <li>Auto AI Review Replies</li>
          <li>Social Media Review Posting</li>
          <li>Custom CRM Integration</li>
          <li>Access to Zapier</li>
          <li>Unlimited Users</li>
          <li>1-1 Setup Call</li>
        </ul>
        <a href="/contact" class="btn-secondary plan-btn" style="text-decoration: none;">Start 10-Day Free Trial</a>
      </div>
    </div>
  </section>

  <!-- Sticky CTA Banner -->
  <section class="section-padding cta-banner-section">
    <div class="atmosphere-card-grey cta-banner border-beam-card">
      <div class="border-beam-content" style="display: flex; justify-content: space-between; align-items: center; width: 100%; gap: 40px; flex-wrap: wrap;">
        <div class="cta-left">
          <h2 class="display-md">Start Automating Reviews Today</h2>
          <p class="body-lg" style="margin-top: 10px;">
            Set up review invites, configure your AI responder, and safeguard your ratings profile with Brand Hyve.
          </p>
        </div>
        <div class="cta-right">
          <a href="/contact" class="btn-primary" style="padding: 16px 36px;">Talk to our team</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '../scripts/main.js';
</script>

<style>
  /* Local Component Styling */
  .reviews-hero {
    padding-top: 150px;
  }

  .section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 60px;
  }

  .section-header .caption {
    color: var(--accent-yellow);
    margin-bottom: 12px;
    display: block;
  }

  .section-header h2 {
    margin-bottom: 20px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
  }

  .card-grid .col-4 {
    grid-column: span 4;
  }

  @media (max-width: 810px) {
    .card-grid .col-4 {
      grid-column: span 12;
    }
  }

  /* Bento Grid Layout */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
    margin-top: 40px;
  }

  .bento-col-8 {
    grid-column: span 8;
  }

  .bento-col-4 {
    grid-column: span 4;
  }

  @media (max-width: 810px) {
    .bento-col-8, .bento-col-4 {
      grid-column: span 12;
    }
  }

  .bento-horizontal {
    display: flex;
    gap: 30px;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .bento-text {
    flex: 1.2;
  }

  .bento-visual {
    flex: 0.8;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  @media (max-width: 650px) {
    .bento-horizontal {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .bento-visual {
      justify-content: flex-start;
    }
  }

  /* SMS Phone Mockup */
  .sms-mockup-wrapper {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid var(--hairline);
    border-radius: var(--rounded-lg);
    padding: 12px;
    width: 100%;
    max-width: 260px;
  }

  .sms-phone {
    background-color: #0b0b0f;
    border: 4px solid #1a1a24;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    width: 100%;
  }

  .sms-header {
    background-color: #12121a;
    padding: 8px;
    font-size: 10px;
    font-weight: 600;
    text-align: center;
    color: var(--ink-muted);
    border-bottom: 1px solid #1c1c28;
  }

  .sms-body {
    padding: 12px;
    min-height: 80px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .sms-message.received {
    background-color: #1e1e2a;
    color: var(--ink);
    padding: 8px 12px;
    border-radius: 12px 12px 12px 2px;
    font-size: 11px;
    line-height: 1.4;
    text-align: left;
    max-width: 95%;
  }

  .sms-message.received span {
    color: var(--accent-yellow);
    text-decoration: underline;
  }

  /* Supported Industries Section */
  .industries-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-top: 40px;
  }

  @media (max-width: 900px) {
    .industries-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 650px) {
    .industries-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 450px) {
    .industries-grid {
      grid-template-columns: 1fr;
    }
  }

  .industry-badge {
    background-color: var(--surface-1);
    border: 1px solid var(--hairline);
    border-radius: var(--rounded-pill);
    padding: 12px 20px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 10px;
    transition: all 0.2s ease;
  }

  .industry-badge:hover {
    border-color: var(--accent-yellow);
    background-color: rgba(255, 219, 21, 0.03);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -5px rgba(255, 219, 21, 0.08);
  }

  .badge-icon {
    font-size: 16px;
  }

  .feature-icon {
    font-size: 32px;
    margin-bottom: 20px;
  }

