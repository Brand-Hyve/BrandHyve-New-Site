---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const published = post.data.date.toISOString().slice(0, 10);
const fmt = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const canonical = `https://www.brandhyve.com/blog/${post.id}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: published,
  author: { '@type': 'Organization', name: post.data.author, url: 'https://www.brandhyve.com/' },
  publisher: { '@type': 'Organization', name: 'Brand Hyve', url: 'https://www.brandhyve.com/' },
  mainEntityOfPage: canonical,
};
---

<Layout
  title={`${post.data.title} | Brand Hyve`}
  description={post.data.description}
  ogImage={post.data.ogImage}
>
  <div class="glow-glow" style="top: 12%; left: 8%;"></div>

  <article class="section-padding blog-post">
    <header class="section-header">
      <span class="caption">{post.data.category} · {fmt}</span>
      <h1 class="display-xl">{post.data.title}</h1>
      <p class="body-lg">{post.data.description}</p>
    </header>

    <div class="blog-body">
      <Content />
    </div>

    <footer class="blog-footer">
      <a href="/blog/" class="btn-secondary">← All posts</a>
      <a href="/contact" class="btn-primary">Book a free 15-minute audit</a>
    </footer>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</Layout>

<style>
  .blog-post .section-header { max-width: 820px; }
  .blog-body { max-width: 760px; margin: 3rem 0 0; font-size: 1.125rem; line-height: 1.7; }
  .blog-body :global(h2) { font-size: 1.75rem; line-height: 1.2; margin: 2.5rem 0 1rem; }
  .blog-body :global(h3) { font-size: 1.3rem; line-height: 1.3; margin: 2rem 0 0.75rem; }
  .blog-body :global(p) { margin: 0 0 1.1rem; }
  .blog-body :global(ul), .blog-body :global(ol) { margin: 0 0 1.25rem 1.25rem; }
  .blog-body :global(li) { margin-bottom: 0.4rem; }
  .blog-body :global(a) { text-decoration: underline; }
  .blog-body :global(blockquote) { margin: 1.5rem 0; padding: 0.25rem 0 0.25rem 1.25rem; border-left: 3px solid currentColor; opacity: 0.85; }
  .blog-body :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 1rem; }
  .blog-body :global(th), .blog-body :global(td) { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid rgba(255, 255, 255, 0.15); vertical-align: top; }
  .blog-body :global(iframe) { max-width: 100%; aspect-ratio: 16 / 9; width: 100%; height: auto; border: 0; border-radius: 12px; margin: 1.5rem 0; }
  .blog-body :global(img) { max-width: 100%; height: auto; border-radius: 12px; }
  .blog-footer { max-width: 760px; margin: 3rem 0 0; display: flex; flex-wrap: wrap; gap: 1rem; }
</style>
